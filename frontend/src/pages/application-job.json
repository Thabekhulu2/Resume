{
  "id": "application-job",
  "title": "Job applications",
  "state": {},
  "dataSources": {
    "job": {
      "type": "supabase",
      "table": "entities",
      "select": "id, entity_versions!inner(data, is_current)",
      "filters": [
        { "field": "id", "op": "eq", "value": "{{params.jobId}}" },
        { "field": "entity_versions.is_current", "op": "eq", "value": true }
      ]
    },
    "applications": {
      "type": "supabase",
      "table": "recruiter_job_applications",
      "select": "*",
      "filters": [{ "field": "job_id", "op": "eq", "value": "{{params.jobId}}" }],
      "order": [{ "column": "applied_at", "ascending": false }]
    }
  },
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Stack",
        "props": { "spacing": 1 },
        "children": [
          { "type": "Link", "props": { "to": "/applications", "children": "Back to Applications" } },
          { "type": "Heading", "props": { "level": 1, "children": "{{data.job[0].entity_versions[0].data.title}}" } },
          { "type": "Text", "props": { "variant": "muted", "children": "Candidates who applied to this job posting" } }
        ]
      },
      {
        "type": "Text",
        "if": "{{data.applications.length === 0}}",
        "props": { "variant": "muted", "children": "No applications for this job." }
      },
      {
        "type": "Stack",
        "props": { "spacing": 3 },
        "children": [
          {
            "type": "Card",
            "each": "{{data.applications}}",
            "as": "application",
            "key": "{{application.candidate_id}}",
            "children": [
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center" },
                "children": [
                  {
                    "type": "Stack",
                    "props": { "spacing": 1 },
                    "children": [
                      {
                        "type": "Text",
                        "props": {
                          "weight": "medium",
                          "children": "{{application.candidate_name || application.resume_file_path}}"
                        }
                      },
                      {
                        "type": "Text",
                        "props": { "variant": "muted", "size": "sm", "children": "Applied to {{application.job_title}}" }
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "props": { "direction": "horizontal", "spacing": 3, "align": "center" },
                    "children": [
                      {
                        "type": "Badge",
                        "if": "{{application.status === 'scored'}}",
                        "props": { "children": "Scored" }
                      },
                      {
                        "type": "Badge",
                        "if": "{{application.status === 'scoring'}}",
                        "props": { "variant": "secondary", "children": "Scoring..." }
                      },
                      {
                        "type": "Badge",
                        "if": "{{application.status === 'failed'}}",
                        "props": { "variant": "destructive", "children": "Failed" }
                      },
                      {
                        "type": "Text",
                        "if": "{{application.score}}",
                        "props": { "weight": "semibold", "children": "{{application.score}}%" }
                      },
                      {
                        "type": "Button",
                        "props": {
                          "variant": "outline",
                          "size": "sm",
                          "children": "Score",
                          "onClick": {
                            "action": "apiCall",
                            "operation": "invoke",
                            "function": "start-scoring-workflow",
                            "data": {
                              "candidate_entity_id": "{{application.candidate_id}}",
                              "resume_storage_path": "{{application.resume_file_path}}",
                              "job_description_entity_id": "{{application.job_id}}"
                            },
                            "onSuccess": { "action": "refetch", "source": "applications" }
                          }
                        }
                      },
                      {
                        "type": "Link",
                        "props": { "to": "/candidates/{{application.candidate_id}}", "children": "View" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
