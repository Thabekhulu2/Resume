{
  "id": "candidate-job-alerts",
  "title": "Job Alerts",
  "state": {
    "keywords": "C# Developer",
    "location": "gauteng",
    "graduate": true,
    "internship": true,
    "permanent": false,
    "frequency": "daily",
    "created": false
  },
  "dataSources": {
    "activeAlerts": {
      "type": "static",
      "data": [
        { "id": 1, "title": "IT / C# Developer", "detail": "Gauteng • Graduate + Internship" }
      ]
    }
  },
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Stack",
        "props": { "spacing": 1 },
        "children": [
          { "type": "Heading", "props": { "level": 1, "children": "Job Alerts" } },
          { "type": "Text", "props": { "variant": "muted", "children": "Get notified when opportunities matching your interests are posted." } }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 4 },
            "children": [
              { "type": "Heading", "props": { "level": 2, "children": "Create Job Alert" } },
              {
                "type": "Alert",
                "if": "{{state.created}}",
                "props": { "title": "Job alert created" }
              },
              {
                "type": "Grid",
                "props": { "columns": 2, "gap": 4 },
                "children": [
                  {
                    "type": "Input",
                    "props": {
                      "label": "Keywords",
                      "value": "{{state.keywords}}",
                      "onChange": { "action": "setState", "key": "keywords", "value": "{{event.target.value}}" }
                    }
                  },
                  {
                    "type": "Select",
                    "props": {
                      "label": "Location",
                      "value": "{{state.location}}",
                      "options": [
                        { "value": "gauteng", "label": "Gauteng" },
                        { "value": "kzn", "label": "KwaZulu-Natal" }
                      ],
                      "onChange": { "action": "setState", "key": "location", "value": "{{event.target.value}}" }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "spacing": 2 },
                "children": [
                  { "type": "Text", "props": { "weight": "medium", "children": "Job type" } },
                  {
                    "type": "Stack",
                    "props": { "direction": "horizontal", "spacing": 4 },
                    "children": [
                      {
                        "type": "Checkbox",
                        "props": {
                          "label": "Graduate",
                          "checked": "{{state.graduate}}",
                          "onChange": { "action": "setState", "key": "graduate", "value": "{{event.target.checked}}" }
                        }
                      },
                      {
                        "type": "Checkbox",
                        "props": {
                          "label": "Internship",
                          "checked": "{{state.internship}}",
                          "onChange": { "action": "setState", "key": "internship", "value": "{{event.target.checked}}" }
                        }
                      },
                      {
                        "type": "Checkbox",
                        "props": {
                          "label": "Permanent",
                          "checked": "{{state.permanent}}",
                          "onChange": { "action": "setState", "key": "permanent", "value": "{{event.target.checked}}" }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "spacing": 2 },
                "children": [
                  { "type": "Text", "props": { "weight": "medium", "children": "Frequency" } },
                  {
                    "type": "Stack",
                    "props": { "direction": "horizontal", "spacing": 4 },
                    "children": [
                      {
                        "type": "Radio",
                        "props": {
                          "name": "frequency",
                          "value": "daily",
                          "label": "Daily",
                          "checked": "{{state.frequency === 'daily'}}",
                          "onChange": { "action": "setState", "key": "frequency", "value": "daily" }
                        }
                      },
                      {
                        "type": "Radio",
                        "props": {
                          "name": "frequency",
                          "value": "weekly",
                          "label": "Weekly",
                          "checked": "{{state.frequency === 'weekly'}}",
                          "onChange": { "action": "setState", "key": "frequency", "value": "weekly" }
                        }
                      },
                      {
                        "type": "Radio",
                        "props": {
                          "name": "frequency",
                          "value": "immediately",
                          "label": "Immediately",
                          "checked": "{{state.frequency === 'immediately'}}",
                          "onChange": { "action": "setState", "key": "frequency", "value": "immediately" }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Button",
                "props": {
                  "children": "Create Alert",
                  "onClick": { "action": "setState", "key": "created", "value": true }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 3 },
            "children": [
              { "type": "Heading", "props": { "level": 2, "children": "Active Alerts" } },
              {
                "type": "Stack",
                "each": "{{data.activeAlerts}}",
                "as": "alert",
                "key": "{{alert.id}}",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b last:border-0" },
                "children": [
                  {
                    "type": "Stack",
                    "props": { "spacing": 0 },
                    "children": [
                      { "type": "Text", "props": { "weight": "medium", "children": "{{alert.title}}" } },
                      { "type": "Text", "props": { "variant": "muted", "size": "sm", "children": "{{alert.detail}}" } }
                    ]
                  },
                  { "type": "Button", "props": { "variant": "outline", "size": "sm", "children": "Pause" } }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
