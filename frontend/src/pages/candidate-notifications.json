{
  "id": "candidate-notifications",
  "title": "Notifications",
  "state": {},
  "dataSources": {
    "notifications": {
      "type": "supabase",
      "table": "notifications",
      "select": "*",
      "order": [{ "column": "created_at", "ascending": false }]
    }
  },
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Stack",
        "props": { "spacing": 1 },
        "children": [
          { "type": "Heading", "props": { "level": 1, "children": "Notifications" } },
          { "type": "Text", "props": { "variant": "muted", "children": "Important updates about your applications and opportunities." } }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 0 },
            "children": [
              {
                "type": "Stack",
                "each": "{{data.notifications}}",
                "as": "n",
                "key": "{{n.id}}",
                "props": {
                  "spacing": 1,
                  "className": "{{n.is_read ? 'py-3 border-b last:border-0' : 'py-3 border-b last:border-0 bg-muted/40'}}"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": { "direction": "horizontal", "justify": "between", "align": "start" },
                    "children": [
                      {
                        "type": "Stack",
                        "props": { "spacing": 1 },
                        "children": [
                          { "type": "Text", "props": { "weight": "medium", "children": "{{n.title}}" } },
                          { "type": "Text", "props": { "variant": "muted", "size": "sm", "children": "{{n.body}}" } }
                        ]
                      },
                      {
                        "type": "Button",
                        "if": "{{!n.is_read}}",
                        "props": {
                          "variant": "ghost",
                          "size": "sm",
                          "children": "Mark read",
                          "onClick": {
                            "action": "apiCall",
                            "operation": "update",
                            "table": "notifications",
                            "match": { "id": "{{n.id}}" },
                            "data": { "is_read": true },
                            "onSuccess": { "action": "refetch", "source": "notifications" }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Text",
                "if": "{{!data.notifications || data.notifications.length === 0}}",
                "props": { "variant": "muted", "className": "text-center py-8", "children": "No notifications yet." }
              }
            ]
          }
        ]
      }
    ]
  }
}
