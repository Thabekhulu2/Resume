{
  "id": "candidate-settings",
  "title": "Settings",
  "state": {
    "notifyApplicationUpdates": true,
    "notifyInterviewReminders": true,
    "notifyJobRecommendations": true,
    "notifyNewMatches": true,
    "privacyRecruiterView": true,
    "privacyJobRecommendations": true
  },
  "dataSources": {},
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Stack",
        "props": { "spacing": 1 },
        "children": [
          { "type": "Heading", "props": { "level": 1, "children": "Settings" } },
          { "type": "Text", "props": { "variant": "muted", "children": "Manage your account, notifications and privacy." } }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 3 },
            "children": [
              { "type": "Heading", "props": { "level": 2, "children": "Notifications" } },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b" },
                "children": [
                  { "type": "Text", "props": { "children": "Application updates" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.notifyApplicationUpdates}}",
                      "onChange": { "action": "setState", "key": "notifyApplicationUpdates", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b" },
                "children": [
                  { "type": "Text", "props": { "children": "Interview reminders" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.notifyInterviewReminders}}",
                      "onChange": { "action": "setState", "key": "notifyInterviewReminders", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b" },
                "children": [
                  { "type": "Text", "props": { "children": "Job recommendations" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.notifyJobRecommendations}}",
                      "onChange": { "action": "setState", "key": "notifyJobRecommendations", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2" },
                "children": [
                  { "type": "Text", "props": { "children": "New matching jobs" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.notifyNewMatches}}",
                      "onChange": { "action": "setState", "key": "notifyNewMatches", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 3 },
            "children": [
              { "type": "Heading", "props": { "level": 2, "children": "Security" } },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b" },
                "children": [
                  { "type": "Text", "props": { "children": "Change password" } },
                  { "type": "Button", "props": { "variant": "outline", "size": "sm", "children": "Change" } }
                ]
              },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2" },
                "children": [
                  { "type": "Text", "props": { "children": "Two-factor authentication" } },
                  { "type": "Badge", "props": { "children": "Enabled" } }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 3 },
            "children": [
              { "type": "Heading", "props": { "level": 2, "children": "Privacy" } },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2 border-b" },
                "children": [
                  { "type": "Text", "props": { "children": "Allow recruiters to view my profile" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.privacyRecruiterView}}",
                      "onChange": { "action": "setState", "key": "privacyRecruiterView", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "props": { "direction": "horizontal", "justify": "between", "align": "center", "className": "py-2" },
                "children": [
                  { "type": "Text", "props": { "children": "Allow job recommendations" } },
                  {
                    "type": "Checkbox",
                    "props": {
                      "checked": "{{state.privacyJobRecommendations}}",
                      "onChange": { "action": "setState", "key": "privacyJobRecommendations", "value": "{{event.target.checked}}" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
