{
  "id": "candidate-upload",
  "title": "Score a Candidate",
  "state": {
    "bulkMode": false,
    "resumeFileName": "",
    "resumeStoragePath": null,
    "resumeFiles": [],
    "resumeStoragePaths": [],
    "jdText": "",
    "jobTitle": "",
    "uploading": false,
    "submitting": false,
    "error": null
  },
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Heading",
        "props": { "level": 1, "children": "Score a Candidate" }
      },
      {
        "type": "Checkbox",
        "props": {
          "label": "Score multiple candidates against this job description",
          "checked": "{{state.bulkMode}}",
          "onChange": {
            "action": "sequence",
            "actions": [
              { "action": "setState", "key": "bulkMode", "value": "{{event.target.checked}}" },
              { "action": "setState", "key": "error", "value": null },
              { "action": "setState", "key": "resumeFileName", "value": "" },
              { "action": "setState", "key": "resumeStoragePath", "value": null },
              { "action": "setState", "key": "resumeFiles", "value": [] },
              { "action": "setState", "key": "resumeStoragePaths", "value": [] }
            ]
          }
        }
      },
      {
        "type": "Alert",
        "if": "{{state.error}}",
        "props": {
          "variant": "destructive",
          "title": "Something went wrong",
          "description": "{{state.error}}"
        }
      },
      {
        "type": "Card",
        "props": { "title": "Resume" },
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 4 },
            "if": "{{!state.bulkMode}}",
            "children": [
              {
                "type": "FileInput",
                "props": {
                  "label": "Resume file (PDF or DOCX)",
                  "accept": ".pdf,.docx",
                  "required": true,
                  "onChange": {
                    "action": "sequence",
                    "actions": [
                      { "action": "setState", "key": "error", "value": null },
                      { "action": "setState", "key": "resumeFileName", "value": "{{event.fileName}}" },
                      { "action": "setState", "key": "resumeStoragePath", "value": null },
                      { "action": "setState", "key": "uploading", "value": true },
                      {
                        "action": "apiCall",
                        "operation": "upload",
                        "bucket": "resumes",
                        "path": "{{event.path}}",
                        "data": "{{event.file}}",
                        "onSuccess": {
                          "action": "sequence",
                          "actions": [
                            { "action": "setState", "key": "uploading", "value": false },
                            { "action": "setState", "key": "resumeStoragePath", "value": "{{event.path}}" }
                          ]
                        },
                        "onError": {
                          "action": "sequence",
                          "actions": [
                            { "action": "setState", "key": "uploading", "value": false },
                            { "action": "setState", "key": "error", "value": "Resume upload failed. Please try again." }
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "type": "Text",
                "if": "{{state.resumeFileName}}",
                "props": { "variant": "muted", "size": "sm", "children": "Selected: {{state.resumeFileName}}" }
              },
              {
                "type": "Text",
                "if": "{{state.uploading}}",
                "props": { "variant": "muted", "size": "sm", "children": "Uploading resume..." }
              }
            ]
          },
          {
            "type": "Stack",
            "props": { "spacing": 4 },
            "if": "{{state.bulkMode}}",
            "children": [
              {
                "type": "FileInput",
                "props": {
                  "label": "Resume files (PDF or DOCX)",
                  "accept": ".pdf,.docx",
                  "multiple": true,
                  "required": true,
                  "onChange": {
                    "action": "sequence",
                    "actions": [
                      { "action": "setState", "key": "error", "value": null },
                      { "action": "setState", "key": "resumeFiles", "value": "{{event.files}}" },
                      { "action": "setState", "key": "resumeStoragePaths", "value": "{{event.paths}}" }
                    ]
                  }
                }
              },
              {
                "type": "Text",
                "if": "{{state.resumeFiles.length}}",
                "props": { "variant": "muted", "size": "sm", "children": "{{state.resumeFiles.length}} file(s) selected" }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "props": { "title": "Job Description" },
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 4 },
            "children": [
              {
                "type": "Input",
                "props": {
                  "label": "Job title",
                  "value": "{{state.jobTitle}}",
                  "onChange": { "action": "setState", "key": "jobTitle", "value": "{{event.target.value}}" }
                }
              },
              {
                "type": "Textarea",
                "props": {
                  "label": "Job description text",
                  "required": true,
                  "rows": 8,
                  "value": "{{state.jdText}}",
                  "onChange": { "action": "setState", "key": "jdText", "value": "{{event.target.value}}" }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Stack",
        "props": { "direction": "horizontal", "justify": "end" },
        "children": [
          {
            "type": "Button",
            "if": "{{!state.bulkMode}}",
            "props": {
              "children": "Score candidate",
              "loading": "{{state.submitting}}",
              "disabled": "{{!state.resumeStoragePath || state.uploading || !state.jdText}}",
              "onClick": {
                "action": "sequence",
                "actions": [
                  { "action": "setState", "key": "error", "value": null },
                  { "action": "setState", "key": "submitting", "value": true },
                  {
                    "action": "apiCall",
                    "operation": "invoke",
                    "function": "start-scoring-workflow",
                    "data": {
                      "resume_storage_path": "{{state.resumeStoragePath}}",
                      "jd_text": "{{state.jdText}}",
                      "job_title": "{{state.jobTitle}}"
                    },
                    "onSuccess": {
                      "action": "navigate",
                      "to": "/candidates/{{event.data.candidate_entity_id}}"
                    },
                    "onError": {
                      "action": "sequence",
                      "actions": [
                        { "action": "setState", "key": "submitting", "value": false },
                        { "action": "setState", "key": "error", "value": "Failed to start scoring. Please try again." }
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "Button",
            "if": "{{state.bulkMode}}",
            "props": {
              "children": "Score {{state.resumeFiles.length}} candidates",
              "loading": "{{state.submitting}}",
              "disabled": "{{!state.resumeFiles.length || state.submitting || !state.jdText}}",
              "onClick": {
                "action": "sequence",
                "actions": [
                  { "action": "setState", "key": "error", "value": null },
                  { "action": "setState", "key": "submitting", "value": true },
                  {
                    "action": "forEach",
                    "items": "{{state.resumeFiles}}",
                    "as": "resumeFile",
                    "do": {
                      "action": "apiCall",
                      "operation": "upload",
                      "bucket": "resumes",
                      "path": "{{resumeFile.path}}",
                      "data": "{{resumeFile.file}}"
                    },
                    "onError": {
                      "action": "sequence",
                      "actions": [
                        { "action": "setState", "key": "submitting", "value": false },
                        { "action": "setState", "key": "error", "value": "Failed to upload one of the resumes. Please try again." }
                      ]
                    },
                    "onSuccess": {
                      "action": "apiCall",
                      "operation": "invoke",
                      "function": "start-scoring-workflow",
                      "data": {
                        "resume_storage_paths": "{{state.resumeStoragePaths}}",
                        "jd_text": "{{state.jdText}}",
                        "job_title": "{{state.jobTitle}}"
                      },
                      "onSuccess": {
                        "action": "navigate",
                        "to": "/candidates"
                      },
                      "onError": {
                        "action": "sequence",
                        "actions": [
                          { "action": "setState", "key": "submitting", "value": false },
                          { "action": "setState", "key": "error", "value": "Failed to start scoring. Please try again." }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
