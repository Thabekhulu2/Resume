{
  "id": "recruiter-interviews",
  "title": "Scheduled Interviews",
  "state": {},
  "dataSources": {
    "interviews": {
      "type": "supabase",
      "table": "recruiter_scheduled_interviews",
      "select": "*",
      "order": [{ "column": "scheduled_at", "ascending": true }]
    }
  },
  "layout": {
    "type": "Stack",
    "props": { "spacing": 6 },
    "children": [
      {
        "type": "Stack",
        "props": { "spacing": 1 },
        "children": [
          { "type": "Heading", "props": { "level": 1, "children": "Scheduled Interviews" } },
          { "type": "Text", "props": { "variant": "muted", "children": "Every interview scheduled with a candidate" } }
        ]
      },
      {
        "type": "Text",
        "if": "{{!data.interviews || data.interviews.length === 0}}",
        "props": { "variant": "muted", "children": "No interviews scheduled yet." }
      },
      {
        "type": "Card",
        "children": [
          {
            "type": "Stack",
            "props": { "spacing": 2 },
            "children": [
              {
                "type": "Stack",
                "each": "{{data.interviews}}",
                "as": "interview",
                "key": "{{interview.id}}",
                "props": {
                  "direction": "horizontal",
                  "justify": "between",
                  "align": "center",
                  "className": "p-4 border rounded-lg"
                },
                "children": [
                  {
                    "type": "Stack",
                    "props": { "spacing": 1 },
                    "children": [
                      {
                        "type": "Text",
                        "props": { "weight": "medium", "children": "{{interview.candidate_name || 'Unnamed candidate'}}" }
                      },
                      {
                        "type": "Text",
                        "props": { "variant": "muted", "size": "sm", "children": "{{interview.job_title || 'Untitled role'}} — {{interview.scheduled_at}}" }
                      },
                      {
                        "type": "Text",
                        "if": "{{interview.notes}}",
                        "props": { "variant": "muted", "size": "sm", "children": "{{interview.notes}}" }
                      }
                    ]
                  },
                  {
                    "type": "Stack",
                    "props": { "direction": "horizontal", "spacing": 2, "align": "center" },
                    "children": [
                      {
                        "type": "Badge",
                        "props": {
                          "variant": "{{interview.status === 'scheduled' ? 'default' : interview.status === 'completed' ? 'secondary' : 'outline'}}",
                          "children": "{{interview.status}}"
                        }
                      },
                      {
                        "type": "Link",
                        "props": { "to": "/candidates/{{interview.candidate_id}}", "children": "View candidate" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
